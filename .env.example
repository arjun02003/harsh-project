# Copy this file to .env and edit. Every line is optional.

SITE_NAME=Nagpur Nest
PORT=3000
NODE_ENV=production

# Search rules
FREE_SEARCHES=1            # searches a new user gets
REFERRAL_BONUS=4           # searches the referrer gets per friend who signs up
MAX_REFERRAL_REWARDS=5     # how many friends can earn rewards for one person

# Plans (price in rupees)
PACK_PRICE=49
PACK_SEARCHES=25
UNLIMITED_PRICE=99
UNLIMITED_DAYS=30          # 0 = unlimited for life

# Where the database file lives (default: ./data/app.db)
# DB_PATH=/var/data/app.db

# Skip the 24 sample listings on first run
# NO_SEED=1
